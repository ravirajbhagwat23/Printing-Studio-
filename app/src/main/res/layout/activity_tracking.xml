<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="← Back" style="@style/Widget.MaterialComponents.Button.TextButton" />

    <TextView android:id="@+id/tvOrderId" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textSize="18sp" android:textStyle="bold" />

    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="Status: Placed" android:textStyle="bold" />

    <Button android:id="@+id/btnNextStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Simulate next status (dev only)"
        android:backgroundTint="@color/bluePrimary" android:textColor="#FFFFFF" />

    <TextView android:id="@+id/tvReady" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Ready for pickup at College Print Shop 🎉"
        android:visibility="gone" />

</LinearLayout>
