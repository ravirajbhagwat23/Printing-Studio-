<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ps_bg">

<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="44dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hi there" android:textColor="@color/ps_muted" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Print anything.\nPick it up on campus." android:textColor="@color/ps_ink" android:textSize="24sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/tvHomeAvatar" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="R" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:background="@drawable/ps_avatar" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:background="@drawable/ps_ticket" android:paddingVertical="16dp" android:paddingHorizontal="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Black &amp; white" android:textColor="#9FB4DD" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="₹2" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="per page" android:textColor="#9FB4DD" android:textSize="12sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Color" android:textColor="#9FB4DD" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="₹10" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="per page" android:textColor="#9FB4DD" android:textSize="12sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back to back" android:textColor="#9FB4DD" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="1 sheet" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="= 2 pages" android:textColor="#9FB4DD" android:textSize="12sp" />
            </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginStart="12dp" android:text="College Print Shop · pickup on campus" android:textColor="#9FB4DD" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="20dp">

    <LinearLayout android:id="@+id/trackCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/ps_card" android:visibility="gone" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Track your order" android:textColor="@color/ps_muted" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvTrackTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="#C-0000" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <View android:id="@+id/trk1" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/ps_track_off" />
            <View android:id="@+id/trk2" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/ps_track_off" />
            <View android:id="@+id/trk3" android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/ps_track_off" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Placed" android:textColor="@color/ps_muted" android:textSize="12sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Printing" android:textColor="@color/ps_muted" android:textSize="12sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Ready" android:textColor="@color/ps_muted" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvTrackStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="" android:textColor="@color/ps_blue" android:textStyle="bold" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/uploadBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/ps_card" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@drawable/ps_nav_active" android:src="@drawable/ic_nav_order" app:tint="#2F6FED" xmlns:app="http://schemas.android.com/apk/res-auto" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/tvFileName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to upload file" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" android:maxLines="2" android:ellipsize="end" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/tvFileHint" android:text="PDF, Word, PowerPoint, image or text file" android:textColor="@color/ps_muted" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/btnChooseFile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose" android:textColor="#2F6FED" android:textStyle="bold" android:padding="8dp" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Print type" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/btnBw" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:text="B/W · ₹2/pg" android:textStyle="bold" android:textSize="14sp" android:clickable="true" android:focusable="true" android:background="@drawable/ps_seg_off" />
        <TextView android:id="@+id/btnColor" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="5dp" android:gravity="center" android:text="Color · ₹10/pg" android:textStyle="bold" android:textSize="14sp" android:clickable="true" android:focusable="true" android:background="@drawable/ps_seg_off" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Sides" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/btnSingle" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:text="Single side" android:textStyle="bold" android:textSize="14sp" android:clickable="true" android:focusable="true" android:background="@drawable/ps_seg_off" />
        <TextView android:id="@+id/btnDouble" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="5dp" android:gravity="center" android:text="Back to back" android:textStyle="bold" android:textSize="14sp" android:clickable="true" android:focusable="true" android:background="@drawable/ps_seg_off" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/ps_card" android:padding="14dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Copies" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/btnMinus" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="−" android:textSize="22sp" android:textColor="@color/ps_ink" android:background="@drawable/ps_seg_off" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tvCopies" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="1" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ps_ink" />
        <TextView android:id="@+id/btnPlus" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="+" android:textSize="22sp" android:textColor="@color/ps_ink" android:background="@drawable/ps_seg_off" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:background="@drawable/ps_card" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Order summary" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/tvBreakdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Upload a PDF to see the price" android:textColor="@color/ps_muted" android:textSize="13sp" />
        <TextView android:id="@+id/btnEditPages" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:paddingVertical="6dp" android:text="Wrong page count? Edit pages" android:textColor="#2F6FED" android:textStyle="bold" android:textSize="13sp" android:visibility="gone" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tvSheets" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/ps_muted" android:textSize="13sp" />
        <TextView android:id="@+id/tvPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Estimated price: ₹0" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="20sp" />
    </LinearLayout>

    <TextView android:id="@+id/btnConfirm" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:gravity="center" android:text="Confirm order" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:background="@drawable/ps_btn_primary" android:clickable="true" android:focusable="true" />

</LinearLayout>
</LinearLayout>
</ScrollView>

<include layout="@layout/layout_bottom_nav" />

</LinearLayout>
