<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ps_bg">

<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingTop="44dp" android:paddingBottom="18dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My profile" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="24sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/ps_hero_card" android:padding="22dp">
        <TextView android:id="@+id/tvAvatar" android:layout_width="84dp" android:layout_height="84dp" android:gravity="center" android:text="R" android:textColor="#FFFFFF" android:textSize="36sp" android:textStyle="bold" android:background="@drawable/ps_avatar" />
        <TextView android:id="@+id/tvProfileName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Student" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="22sp" />
        <TextView android:id="@+id/tvProfileEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="" android:textColor="@color/ps_muted" android:textSize="14sp" />
        <TextView android:id="@+id/tvSince" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/ps_seg_off" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Member since" android:textColor="@color/ps_ink" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/btnEditTop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/ps_seg_on" android:paddingHorizontal="26dp" android:paddingVertical="10dp" android:text="Edit profile" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"  android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/ps_card" android:paddingVertical="14dp">
                <TextView android:id="@+id/stOrders" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Orders" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/ps_card" android:paddingVertical="14dp">
                <TextView android:id="@+id/stPages" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Pages printed" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"  android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/ps_card" android:paddingVertical="14dp">
                <TextView android:id="@+id/stSpent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Total spent" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/ps_card" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Personal information" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="17sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Full name" android:textColor="@color/ps_muted" android:textSize="12sp" />
        <TextView android:id="@+id/pName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not provided" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="16sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/ps_line" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Email address" android:textColor="@color/ps_muted" android:textSize="12sp" />
        <TextView android:id="@+id/pEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not provided" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="16sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/ps_line" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Mobile number" android:textColor="@color/ps_muted" android:textSize="12sp" />
        <TextView android:id="@+id/pMobile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not provided" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="16sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/ps_line" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/ps_card" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="17sp" />
        <LinearLayout android:id="@+id/rowEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="✏️" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit profile" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Update your name and mobile number" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="🔒" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Change password" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Get a reset link by email" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="🕘" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Order history" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View past print jobs and status" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/ps_card" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Support" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="17sp" />
        <LinearLayout android:id="@+id/rowFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="💬" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send feedback" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tell us how to make the app better" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowShare" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="🔗" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share the app" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Invite friends to use Printing Studio" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="❓" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Help &amp; support" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contact the college print shop" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="🛡️" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Privacy policy" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="How your data is used" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="ℹ️" android:textSize="18sp" android:background="@drawable/ps_nav_active" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="About app" android:textColor="@color/ps_ink" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="College Print Shop v1.0" android:textColor="@color/ps_muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/ps_muted" android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:gravity="center" android:text="Log out" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:background="@drawable/ps_btn_danger" android:clickable="true" android:focusable="true" />

</LinearLayout>
</ScrollView>

<include layout="@layout/layout_bottom_nav" />

</LinearLayout>
